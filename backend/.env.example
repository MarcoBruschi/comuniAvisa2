# Porta do servidor backend
PORT=5000

# Ambiente de execução (development | production)
NODE_ENV=development

# Conexão com o banco de dados MongoDB
# Exemplo local:
MONGO_URI=mongodb://localhost:27017/comuniavisa
# Exemplo MongoDB Atlas:
# MONGO_URI=mongodb+srv://<usuario>:<senha>@cluster.mongodb.net/comuniavisa?retryWrites=true&w=majority

# URL do frontend para liberação no CORS
FRONTEND_URL=http://localhost:5173

# Chaves secretas de segurança
COOKIE_KEY=sua_chave_secreta_para_cookies
ACCESS_SECRET_KEY=sua_chave_secreta_jwt_access
REFRESH_SECRET_KEY=sua_chave_secreta_jwt_refresh
